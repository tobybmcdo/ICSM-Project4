# Copy to .env, then add the Canvas Developer Key credentials supplied by your Canvas administrator.
CANVAS_CLIENT_ID=
CANVAS_CLIENT_SECRET=

# Must match the redirect URI registered on the Canvas Developer Key.
APP_ORIGIN=http://localhost:3000
CANVAS_REDIRECT_URI=http://localhost:3000/auth/callback

# Read-only access to active classes and published Canvas course pages.
CANVAS_SCOPES=url:GET|/api/v1/courses url:GET|/api/v1/courses/:course_id/pages
PORT=3000
